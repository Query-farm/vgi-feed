# Keep the build context small: the Dockerfile only needs go.mod/go.sum + the
# cmd/ and internal/ sources. Everything below is rebuilt inside the image or
# irrelevant — in particular the prebuilt worker/mock binaries (~100MB) and the
# git history must never enter the context.
.git
.github
.gitignore
/vgi-feed-worker
/mockserver
duckdb_unittest_tempdir
test
docs
README.md
Makefile
.golangci.yml
.vgi-review-cache.json
.vgi-sim-cache.json
**/*_test.go
.DS_Store
