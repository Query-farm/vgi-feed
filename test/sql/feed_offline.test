# name: test/sql/feed_offline.test
# description: OFFLINE feed_items / feed_info over inline raw RSS/Atom/JSON
#              documents (no network, no mock server). Used by the Docker
#              image_test to exercise the container's transports without a
#              reachable mock backend; also runs in the normal CI matrix.
# group: [vgi_feed]

require-env VGI_FEED_WORKER

# haybarn-unittest does NOT autoload the extension for `require vgi` (it is
# silently SKIPPED). Load it explicitly instead.
statement ok
LOAD vgi;

statement ok
ATTACH 'feed' AS feed (TYPE vgi, LOCATION '{VGI_FEED_WORKER}');

# ---- feed_info detects the format of each inline document ----

query T
SELECT feed_type
FROM feed.feed_info('<?xml version="1.0"?><rss version="2.0"><channel><title>Inline RSS</title><item><title>a</title></item><item><title>b</title></item></channel></rss>');
----
rss

query T
SELECT feed_type
FROM feed.feed_info('<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom"><title>Inline Atom</title><id>urn:x</id><entry><title>a</title><id>u1</id></entry></feed>');
----
atom

query T
SELECT feed_type
FROM feed.feed_info('{"version":"https://jsonfeed.org/version/1.1","title":"Inline JSON","items":[{"id":"1","title":"x"},{"id":"2","title":"y"}]}');
----
json

# ---- feed_info title + item_count from an inline RSS document ----

query TI
SELECT title, item_count
FROM feed.feed_info('<?xml version="1.0"?><rss version="2.0"><channel><title>Inline RSS</title><item><title>a</title></item><item><title>b</title></item></channel></rss>');
----
Inline RSS	2

# ---- feed_items expands the inline RSS entries (ordered by seq) ----

query I
SELECT count(*)
FROM feed.feed_items('<?xml version="1.0"?><rss version="2.0"><channel><title>t</title><item><title>First Inline</title><link>https://x/1</link></item><item><title>Second Inline</title><link>https://x/2</link></item></channel></rss>');
----
2

query TT
SELECT title, link
FROM feed.feed_items('<?xml version="1.0"?><rss version="2.0"><channel><title>t</title><item><title>First Inline</title><link>https://x/1</link></item><item><title>Second Inline</title><link>https://x/2</link></item></channel></rss>')
ORDER BY seq;
----
First Inline	https://x/1
Second Inline	https://x/2

# ---- max_items named option caps the inline result ----

query I
SELECT count(*)
FROM feed.feed_items('<?xml version="1.0"?><rss version="2.0"><channel><title>t</title><item><title>a</title></item><item><title>b</title></item></channel></rss>', max_items := 1);
----
1

# ---- JSON Feed items parse directly from inline text ----

query T
SELECT title
FROM feed.feed_items('{"version":"https://jsonfeed.org/version/1.1","title":"j","items":[{"id":"1","title":"JSON One"}]}')
ORDER BY seq;
----
JSON One

# ---- malformed inline text surfaces a clean error ----

statement error
SELECT * FROM feed.feed_items('<rss><channel><title>broken</title><item><title>oops');
----

# ---- composed catalog examples (feed_items x feed_items, feed_info + feed_items) ----

# New entries since an earlier snapshot: anti-join two feed_items calls on link.
query ITT
SELECT cur.seq, cur.title, cur.link
FROM feed.main.feed_items('<rss version="2.0"><channel><title>Query Farm Sample Feed</title><link>https://query.farm/</link><description>A small RSS feed used by vgi-feed examples</description><language>en-us</language><item><title>First Post</title><link>https://query.farm/first</link><category>news</category><category>release</category><description>The first sample entry</description></item><item><title>Second Post</title><link>https://query.farm/second</link><category>news</category><description>The second sample entry</description></item></channel></rss>') AS cur
ANTI JOIN feed.main.feed_items('<rss version="2.0"><channel><title>Query Farm Sample Feed</title><item><title>First Post</title><link>https://query.farm/first</link></item></channel></rss>') AS prev ON cur.link = prev.link
ORDER BY cur.seq;
----
1	Second Post	https://query.farm/second

# Category breakdown against feed_info's reported item_count.
query TTIR
SELECT f.title AS feed_title, c.category, count(*) AS entries, round(count(*) / f.item_count, 2) AS share_of_feed
FROM feed.main.feed_info('<rss version="2.0"><channel><title>Query Farm Sample Feed</title><link>https://query.farm/</link><description>A small RSS feed used by vgi-feed examples</description><language>en-us</language><item><title>First Post</title><link>https://query.farm/first</link><category>news</category><category>release</category><description>The first sample entry</description></item><item><title>Second Post</title><link>https://query.farm/second</link><category>news</category><description>The second sample entry</description></item></channel></rss>') AS f
CROSS JOIN (SELECT UNNEST(categories) AS category FROM feed.main.feed_items('<rss version="2.0"><channel><title>Query Farm Sample Feed</title><link>https://query.farm/</link><description>A small RSS feed used by vgi-feed examples</description><language>en-us</language><item><title>First Post</title><link>https://query.farm/first</link><category>news</category><category>release</category><description>The first sample entry</description></item><item><title>Second Post</title><link>https://query.farm/second</link><category>news</category><description>The second sample entry</description></item></channel></rss>')) AS c
GROUP BY f.title, f.item_count, c.category
ORDER BY entries DESC, c.category;
----
Query Farm Sample Feed	news	2	1.0
Query Farm Sample Feed	release	1	0.5
